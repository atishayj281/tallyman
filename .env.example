# Copy to .env and fill in. .env is gitignored; this file is the contract.
# Anything with a real secret in it must NOT have a default in code.

# --- app ---
WA_ENV=local
WA_LOG_LEVEL=INFO

# --- object storage (SeaweedFS S3 endpoint, set up in WA-02) ---
WA_S3_ENDPOINT=http://seaweedfs:8333
WA_S3_ACCESS_KEY=change-me-access
WA_S3_SECRET_KEY=change-me-secret
WA_S3_BUCKET_RAW=wa-raw
WA_S3_BUCKET_MART=wa-mart

# --- LLM (used from WA-15 onwards) ---
WA_LLM_PROVIDER=ollama
WA_LLM_MODEL=llama3.1
ANTHROPIC_API_KEY=
